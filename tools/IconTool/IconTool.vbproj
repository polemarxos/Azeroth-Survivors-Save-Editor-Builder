<Project Sdk="Microsoft.NET.Sdk">
  <!-- Small helper used by build.bat: copies the game's icon into app.ico -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AzsEditorBuilder</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <OptionStrict>On</OptionStrict>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Core/IconExtractor.vb" />
  </ItemGroup>
</Project>
